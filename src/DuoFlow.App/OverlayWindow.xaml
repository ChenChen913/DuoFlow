<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuoFlow.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DuoFlow Overlay">

    <!-- Fully transparent root: the overlay only paints its decorations
         (capture preview + status chips). Everything else lets the desktop
         show through, and WS_EX_TRANSPARENT forwards mouse input below. -->
    <Grid x:Name="Root" Background="Transparent" IsHitTestVisible="False">

        <!-- M0.3: the M0.2 capture preview now lives INSIDE the overlay
             (bottom-right corner), standing in for the future effect output. -->
        <StackPanel
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,24,24">
            <Border
                Background="#CC111111"
                CornerRadius="8"
                Padding="10,4"
                HorizontalAlignment="Right"
                Margin="0,0,0,8">
                <TextBlock
                    x:Name="OverlayCaption"
                    Foreground="White"
                    FontSize="12"
                    Text="overlay · capture starting..." />
            </Border>
            <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8">
                <SwapChainPanel x:Name="CapturePanel" Width="480" Height="270" />
            </Border>
        </StackPanel>

        <!-- status chip (top-right; the console window sits bottom-left) -->
        <Border
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,24,24,0"
            Background="#CC111111"
            CornerRadius="8"
            Padding="12,6">
            <TextBlock
                x:Name="OverlayStatus"
                Foreground="White"
                FontSize="12"
                Text="M0.3 overlay · fullscreen · topmost · click-through · no-activate" />
        </Border>
    </Grid>

</Window>
