<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuoFlow.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DuoFlow Overlay">

    <!-- Fully transparent root: the overlay paints only its decorations.
         Everything else lets the desktop show through, and
         WS_EX_TRANSPARENT forwards mouse input below. -->
    <Grid x:Name="Root" Background="Transparent" IsHitTestVisible="False">

        <!-- M1.8 fullscreen composite: the SwapChainPanel covers the WHOLE
             overlay - the fold/blur/dim effect renders across the entire
             screen instead of the small corner preview. The panel's pixel
             size (1536x864 DIP x 1.25 = 1920x1080) coincides with the
             capture size, satisfying the swapchain-size workaround
             (HC 6.2) at zero downscale. -->
        <SwapChainPanel x:Name="CapturePanel" />

        <!-- status chip (top-right; the console window sits bottom-left) -->
        <Border
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,24,24,0"
            Background="#CC111111"
            CornerRadius="8"
            Padding="12,6">
            <TextBlock
                x:Name="OverlayStatus"
                Foreground="White"
                FontSize="12"
                Text="M0.3 overlay · fullscreen · topmost · click-through · no-activate" />
        </Border>

        <!-- capture/warp diagnostics (top-right, below the status chip) -->
        <Border
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,70,24,0"
            Background="#CC111111"
            CornerRadius="8"
            Padding="10,4">
            <TextBlock
                x:Name="OverlayCaption"
                Foreground="White"
                FontSize="12"
                Text="overlay · capture starting..." />
        </Border>
    </Grid>

</Window>
