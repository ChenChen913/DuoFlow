<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuoFlow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DuoFlow">

    <Grid>
        <!-- M0.2: live desktop capture, blitted GPU -> GPU -->
        <SwapChainPanel x:Name="CapturePanel" />

        <Border
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,0,0,24"
            Background="#CC111111"
            CornerRadius="10"
            Padding="16,8">
            <TextBlock
                x:Name="StatusText"
                Foreground="White"
                FontSize="13"
                Text="M0.2 · starting capture..." />
        </Border>
    </Grid>

</Window>
