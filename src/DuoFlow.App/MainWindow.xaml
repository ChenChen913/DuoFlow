<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuoFlow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DuoFlow Console — M0.3 Overlay · M1.2 Manual · M1.4 Warp · M2.5 Tuning">

    <!-- M1.2 keyboard control: WinUI 3's Window class has no KeyDown event
         (unlike WPF), so Home/End are KeyboardAccelerators on the ROOT
         element. With ScopeOwner unset they have global scope - they fire
         no matter which element holds focus, so the slider never needs to
         grab focus first. -->
    <ScrollViewer>
        <ScrollViewer.KeyboardAccelerators>
            <KeyboardAccelerator Key="Home" Invoked="OnHomeAcceleratorInvoked" />
            <KeyboardAccelerator Key="End" Invoked="OnEndAcceleratorInvoked" />
        </ScrollViewer.KeyboardAccelerators>

        <StackPanel Margin="18,16,18,16" Spacing="10">
            <TextBlock
                FontSize="17"
                FontWeight="SemiBold"
                Text="DuoFlow · M0.3 Overlay 验证台" />
            <TextBlock
                x:Name="Report"
                FontFamily="Consolas"
                FontSize="12.5"
                TextWrapping="Wrap"
                Foreground="#1A1A1A"
                Text="初始化中…" />

            <Border Height="1" Background="#E0E0E0" Margin="0,4,0,4" />

            <!-- M1.2 Manual Progress: Slider -> ManualProvider.SetProgress ->
                 StateChanged -> display. The slider value is NOT fed to the
                 render layer directly (DD-002): the chain continues only
                 through the provider (M1.3 smoothing -> M1.4 Warp). -->
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Text="Manual Progress（M1.2）" />
            <!-- M2.5: explicit AutomationId. Since the tuning panel added six
                 more sliders, "first Slider in the subtree" is no longer a
                 safe way for the acceptance harness to find THIS one. -->
            <Slider
                x:Name="ProgressSlider"
                AutomationProperties.AutomationId="ProgressSlider"
                Header="Progress：0 = 全开 · 1 = 接近全关（步进 0.01）"
                Minimum="0"
                Maximum="1"
                StepFrequency="0.01"
                Value="0"
                ValueChanged="OnProgressSliderValueChanged" />
            <TextBlock
                x:Name="ProgressText"
                FontFamily="Consolas"
                FontSize="14.5"
                Text="Progress 0.00 · Angle ≈ 180.0°（§6 示意映射）" />
            <TextBlock
                x:Name="SmoothText"
                FontFamily="Consolas"
                FontSize="12.5"
                Foreground="#444444"
                Text="平滑 Progress 0.00（AnimationEngine → Warp）" />
            <TextBlock
                FontSize="11.5"
                Foreground="#666666"
                TextWrapping="Wrap"
                Text="键盘：Home → 0（全开） · End → 1（接近全关）——全局加速键，无需先点选 Slider 获取焦点" />

            <Border Height="1" Background="#E0E0E0" Margin="0,8,0,4" />

            <!-- M2.4 demo mode. Drives ManualProvider.SetProgress on a 30ms
                 clock - the same entry point the slider uses - so the input
                 chain (DD-002) is untouched and the engine still does the
                 smoothing. Grabbing the slider pauses the demo. -->
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Text="演示模式（M2.4）" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="PlayOpeningButton"
                    AutomationProperties.AutomationId="PlayOpeningButton"
                    Content="开盖 0→1"
                    Click="OnPlayOpening" />
                <Button
                    x:Name="PlayClosingButton"
                    AutomationProperties.AutomationId="PlayClosingButton"
                    Content="合盖 1→0"
                    Click="OnPlayClosing" />
                <Button
                    x:Name="PauseDemoButton"
                    AutomationProperties.AutomationId="PauseDemoButton"
                    Content="暂停"
                    Click="OnPauseDemo" />
            </StackPanel>
            <CheckBox
                x:Name="LoopCheck"
                AutomationProperties.AutomationId="LoopCheck"
                Content="循环往返（到端点自动反向）"
                Checked="OnLoopChanged"
                Unchecked="OnLoopChanged" />
            <Slider
                x:Name="DurationSlider"
                AutomationProperties.AutomationId="DurationSlider"
                Header="单程时长（秒，0.5~4）"
                Minimum="0.5"
                Maximum="4"
                StepFrequency="0.1"
                Value="1.5" />
            <TextBlock
                x:Name="DemoStatus"
                AutomationProperties.AutomationId="DemoStatus"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="#444444"
                Text="演示模式空闲" />

            <Border Height="1" Background="#E0E0E0" Margin="0,8,0,4" />

            <!-- M2.5 render tuning. NOTE the separation from the block above:
                 Progress is LID INPUT (provider → engine → render, DD-002),
                 these are RENDER CONFIGURATION (they change how the same
                 progress is drawn, DD-048). Nothing here feeds ManualProvider,
                 and the engine never sees these values. -->
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Text="渲染参数（M2.5）" />
            <TextBlock
                x:Name="TuningStatus"
                AutomationProperties.AutomationId="TuningStatus"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="#444444"
                TextWrapping="Wrap"
                Text="参数面板初始化中…" />

            <Slider
                x:Name="MaxFoldSlider"
                AutomationProperties.AutomationId="MaxFoldSlider"
                Header="折叠角度 MaxFold（°，1~90）"
                Minimum="1"
                Maximum="90"
                StepFrequency="1"
                Value="90"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="CameraSlider"
                AutomationProperties.AutomationId="CameraSlider"
                Header="相机距离 r（屏高倍数，&gt;1；越小透视越猛）"
                Minimum="1.1"
                Maximum="6"
                StepFrequency="0.05"
                Value="2.5"
                ValueChanged="OnTuningValueChanged" />
            <ComboBox
                x:Name="TiltCombo"
                AutomationProperties.AutomationId="TiltCombo"
                Header="折叠方向（远边）"
                SelectedIndex="0"
                SelectionChanged="OnTuningSelectionChanged">
                <ComboBoxItem Content="向后倒 away（投影变窄，像显示器后仰）" />
                <ComboBoxItem Content="向前倾 toward（远边溢出画面，像合盖压过来）" />
            </ComboBox>
            <ComboBox
                x:Name="HingeCombo"
                AutomationProperties.AutomationId="HingeCombo"
                Header="铰链边"
                SelectedIndex="0"
                SelectionChanged="OnTuningSelectionChanged">
                <ComboBoxItem Content="底边 bottom（默认）" />
                <ComboBoxItem Content="顶边 top（上下镜像）" />
            </ComboBox>
            <Slider
                x:Name="MaxBlurSlider"
                AutomationProperties.AutomationId="MaxBlurSlider"
                Header="最大模糊半径（设备像素，1~400）"
                Minimum="1"
                Maximum="400"
                StepFrequency="1"
                Value="160"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="EnvelopeStartSlider"
                AutomationProperties.AutomationId="EnvelopeStartSlider"
                Header="模糊包络起点（低于此值无模糊/无变暗）"
                Minimum="0"
                Maximum="0.85"
                StepFrequency="0.01"
                Value="0.30"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="EnvelopeFullSlider"
                AutomationProperties.AutomationId="EnvelopeFullSlider"
                Header="模糊包络满值点（必须大于起点）"
                Minimum="0.05"
                Maximum="1"
                StepFrequency="0.01"
                Value="0.60"
                ValueChanged="OnTuningValueChanged" />
            <Button
                x:Name="ResetTuningButton"
                AutomationProperties.AutomationId="ResetTuningButton"
                Content="恢复默认"
                Click="OnResetTuning" />

            <TextBlock
                FontSize="13.5"
                FontWeight="SemiBold"
                Margin="0,6,0,0"
                Text="渐变色相（M2.1）" />
            <CheckBox
                x:Name="GradientCheck"
                AutomationProperties.AutomationId="GradientCheck"
                Content="启用渐变色相（只作用于阴影侧，不影响铰链亮区）"
                Checked="OnTuningToggled"
                Unchecked="OnTuningToggled" />
            <Slider
                x:Name="HueStartSlider"
                AutomationProperties.AutomationId="HueStartSlider"
                Header="起色相（铰链侧，0~360°）"
                Minimum="0"
                Maximum="360"
                StepFrequency="5"
                Value="205"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="HueEndSlider"
                AutomationProperties.AutomationId="HueEndSlider"
                Header="止色相（远端，0~360°）"
                Minimum="0"
                Maximum="360"
                StepFrequency="5"
                Value="275"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="GradientStrengthSlider"
                AutomationProperties.AutomationId="GradientStrengthSlider"
                Header="强度（0~0.2，上限写死在 GradientOptions）"
                Minimum="0"
                Maximum="0.2"
                StepFrequency="0.01"
                Value="0"
                ValueChanged="OnTuningValueChanged" />
            <TextBlock
                FontSize="11.5"
                Foreground="#666666"
                TextWrapping="Wrap"
                Text="改值即时生效（同一 UI 线程，无锁）。越界组合会被整体拒绝并在上面显示原因，不会半途生效。" />

            <TextBlock
                FontSize="13.5"
                FontWeight="SemiBold"
                Margin="0,6,0,0"
                Text="光带扫过（M2.2）" />
            <CheckBox
                x:Name="SweepCheck"
                AutomationProperties.AutomationId="SweepCheck"
                Content="启用光带（中性高光，只加亮度不改色相）"
                Checked="OnTuningToggled"
                Unchecked="OnTuningToggled" />
            <Slider
                x:Name="SweepPositionSlider"
                AutomationProperties.AutomationId="SweepPositionSlider"
                Header="位置（沿扫动方向提前量，0~1）"
                Minimum="0"
                Maximum="1"
                StepFrequency="0.05"
                Value="0"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="SweepWidthSlider"
                AutomationProperties.AutomationId="SweepWidthSlider"
                Header="宽度（半高全宽，0.02~0.5）"
                Minimum="0.02"
                Maximum="0.5"
                StepFrequency="0.01"
                Value="0.10"
                ValueChanged="OnTuningValueChanged" />
            <Slider
                x:Name="SweepStrengthSlider"
                AutomationProperties.AutomationId="SweepStrengthSlider"
                Header="强度（0~0.2，上限写死在 LightSweepOptions）"
                Minimum="0"
                Maximum="0.2"
                StepFrequency="0.01"
                Value="0.08"
                ValueChanged="OnTuningValueChanged" />
            <ComboBox
                x:Name="SweepDirectionCombo"
                AutomationProperties.AutomationId="SweepDirectionCombo"
                Header="方向"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnTuningSelectionChanged">
                <ComboBoxItem Content="铰链 → 远端（默认）" />
                <ComboBoxItem Content="远端 → 铰链" />
            </ComboBox>
        </StackPanel>
    </ScrollViewer>

</Window>
