<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuoFlow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DuoFlow Console — M0.3 Overlay · M1.2 Manual Progress">

    <!-- M1.2 keyboard control: WinUI 3's Window class has no KeyDown event
         (unlike WPF), so Home/End are KeyboardAccelerators on the ROOT
         element. With ScopeOwner unset they have global scope - they fire
         no matter which element holds focus, so the slider never needs to
         grab focus first. -->
    <ScrollViewer>
        <ScrollViewer.KeyboardAccelerators>
            <KeyboardAccelerator Key="Home" Invoked="OnHomeAcceleratorInvoked" />
            <KeyboardAccelerator Key="End" Invoked="OnEndAcceleratorInvoked" />
        </ScrollViewer.KeyboardAccelerators>

        <StackPanel Margin="18,16,18,16" Spacing="10">
            <TextBlock
                FontSize="17"
                FontWeight="SemiBold"
                Text="DuoFlow · M0.3 Overlay 验证台" />
            <TextBlock
                x:Name="Report"
                FontFamily="Consolas"
                FontSize="12.5"
                TextWrapping="Wrap"
                Foreground="#1A1A1A"
                Text="初始化中…" />

            <Border Height="1" Background="#E0E0E0" Margin="0,4,0,4" />

            <!-- M1.2 Manual Progress: Slider -> ManualProvider.SetProgress ->
                 StateChanged -> display. The slider value is NOT fed to the
                 render layer directly (DD-002): the chain continues only
                 through the provider (M1.3 smoothing -> M1.4 Warp). -->
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Text="Manual Progress（M1.2）" />
            <Slider
                x:Name="ProgressSlider"
                Header="Progress：0 = 全开 · 1 = 接近全关（步进 0.01）"
                Minimum="0"
                Maximum="1"
                StepFrequency="0.01"
                Value="0"
                ValueChanged="OnProgressSliderValueChanged" />
            <TextBlock
                x:Name="ProgressText"
                FontFamily="Consolas"
                FontSize="14.5"
                Text="Progress 0.00 · Angle ≈ 180.0°（§6 示意映射）" />
            <TextBlock
                FontSize="11.5"
                Foreground="#666666"
                TextWrapping="Wrap"
                Text="键盘：Home → 0（全开） · End → 1（接近全关）——全局加速键，无需先点选 Slider 获取焦点" />
        </StackPanel>
    </ScrollViewer>

</Window>
