<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>DuoFlow.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged (no MSIX / no signing cert needed) + self-contained WinAppSDK runtime.
         M0.1 keeps it minimal; MSIX packaging arrives in M11 (see docs/TODO.md). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.*" />
    <PackageReference Include="Vortice.DXGI" Version="3.*" />
    <PackageReference Include="Vortice.WinUI" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- M1.4 (DD-039): the warp shader ships next to the exe and is compiled
         at startup (D3DCompile via Vortice.D3DCompiler) - no build-time FXC
         dependency, so plain dotnet/VS MSBuild CI needs no extra workload. -->
    <Content Include="..\..\shaders\DuoWarp.hlsl" Link="shaders\DuoWarp.hlsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuoFlow.Capture\DuoFlow.Capture.csproj" />
    <!-- M1.2: the console window drives ManualProvider (Slider -> SetProgress
         -> StateChanged -> display). Core is pure net8.0 (no WinUI/D3D/WinAppSDK),
         so referencing it from the net8.0-windows App pulls nothing heavy in. -->
    <ProjectReference Include="..\DuoFlow.Core\DuoFlow.Core.csproj" />
    <!-- M1.4: warp geometry (pure net8.0, unit tested) feeds the shader. -->
    <ProjectReference Include="..\DuoFlow.Render\DuoFlow.Render.csproj" />
  </ItemGroup>

</Project>
