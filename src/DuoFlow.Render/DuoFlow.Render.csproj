<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DuoFlow.Render - render-side math and pipeline support (M1.4).

    Pure net8.0 on purpose (same reasoning as DuoFlow.Core): the warp
    geometry must be unit-testable without any D3D/WinUI dependency, and
    cloud CI can validate it with plain "dotnet test". The D3D11 parts of
    the render pipeline live in DuoFlow.App (WarpPipeline / CaptureRenderer)
    because they share the capture device; this project holds the pieces
    that must be provable by tests alone (TECHNICAL_PROPOSAL §24 plans the
    module; M1.5+ Hinge-Mask / Blur / Dimming math lands here too).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DuoFlow.Render</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

</Project>
